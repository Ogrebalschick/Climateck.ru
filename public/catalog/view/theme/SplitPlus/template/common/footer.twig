1<footer>
    <div class="container">
        <div class="footer__inner">
            <ul class="footer__list list">
                {% if categories %}
                    <li class="footer__item">
                        <div class="footer__title">Каталог</div>
                        <ul class="footer__sublist list">
                            {% for category in categories %}
                                <li class="footer__subitem"><a href="{{ category.href }}" class="link--underline">{{ category.name }}</a></li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endif %}
                {{ list_footer }}
                <div class="footer__item footer__item--contacts">
                    <div class="footer__title">Связаться</div>
                    <div class="footer__sublist list">
                        <div class="footer__subitem"><span>Телефон:</span><p><a href="tel:{{ telephone }}">{{ telephone }}</a></p></div>
                        <div class="footer__subitem"><span>E-mail:</span><p><a href="mailto:{{ email }}">{{ email }}</a></p></div>
                        <div class="footer__subitem"><span>Адрес:</span><p>{{ address|raw }}</p></div>
                    </div>
                </div>
            </ul>
        </div>
    </div>
</footer>

</main>
</body>
<div class="popup popup--callback" id="popup--callback">
    <div class="form-wrapper">
        <div class="form__exit">⨉</div>
        <div class="form__title">Обратный звонок</div>
        <form action="" id="form-callback" class="form form-callback">
            <input type="text" name="firstname" placeholder="Имя">
            <input type="text" name="phone" placeholder="Телефон">
            <button type="submit" class="btn btn--glare">Отправить</button>
        </form>
    </div>  
</div>
<div class="popup popup--success" id="popup--success">
    <div class="form-wrapper">
        <div class="form__exit">⨉</div>
        <div class="form__title">Заявка оставлена!</div>
        <div class="form__text">Спасибо за заявку, мы свяжемся с вами в ближайшее время.</div>
    </div>  
</div>
<script>
    // форма обратной связи
    $(document).ready(function () {
    $(document).on('submit', '.form-callback', function (e) {
        e.preventDefault(); // отменяем стандартный сабмит

        var form = $(this);

        $.ajax({
            type: "POST",
            url: "index.php?route=common/header/send_form",
            data: form.serialize(),
            dataType: "json",
            success: function (json) {
                if (json['success']) {
                    console.log('отправлено!');
                    $('.popup').removeClass('active')
                    $('#popup--success').addClass('active')
                    form.reset();
                } else {
                    console.log('ошибка');
                }
            },
            error: function (xhr, status, error) {
                console.log('Ошибка AJAX: ' + error);
            }
        });

        return false; // ещё раз подстраховка
    });
});


    // popup, обязательно к кнопке: data-popup="myPopup" а , popup: id="myPopup"
    document.querySelectorAll('.btn--popup').forEach(trigger => {
        trigger.addEventListener('click', () => {
            const popupId = trigger.dataset.popup;
            document.getElementById(popupId).classList.add('active');
        });
    });

    // popup, закрытие по кнопке
    document.querySelectorAll('.form__exit').forEach(exit => {
        exit.addEventListener('click', () => {
            const popup = exit.closest('.popup');
            if (popup) popup.classList.remove('active');
        });
    });


    // Закрытие при клике вне .form-wrapper
    document.querySelectorAll('.popup').forEach(popup => {
    popup.addEventListener('click', (e) => {
        const isClickInside = e.target.closest('.form-wrapper');
        if (!isClickInside) {
        popup.classList.remove('active');
        }
    });
    });

    // Закрытие по ESC
    document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        document.querySelectorAll('.popup.active').forEach(popup => {
        popup.classList.remove('active');
        });
    }
    });
</script>

<script src="catalog/view/theme/SplitPlus/javascript/script.js" type="text/javascript"></script>

{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}
<script src="catalog/view/theme/SplitPlus/javascript/product.js" type="text/javascript"></script>
</html>