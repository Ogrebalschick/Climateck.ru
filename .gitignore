# OS junk
.DS_Store
Thumbs.db
.cursor/

# OpenCart configs with DB credentials and local paths.
# Copy public/config-dist.php and public/admin/config-dist.php, then fill them in.
public/config.php
public/admin/config.php
public/configs/config.php
public/configs/config-adm.php
/config.php
/admin/config.php

# Cache, logs, sessions, OCMOD cache, uploads.
# index.html and .htaccess stay tracked so the directories exist in a fresh clone.
public/system/storage/cache/*
!public/system/storage/cache/index.html
public/system/storage/logs/*
!public/system/storage/logs/index.html
public/system/storage/modification/*
!public/system/storage/modification/index.html
public/system/storage/session/*
!public/system/storage/session/index.html
!public/system/storage/session/.htaccess
public/system/storage/upload/*
!public/system/storage/upload/index.html
public/image/cache/

# SimplePars page cache (scraped HTML, not source)
public/admin/simplepars/cache_page/

/system/storage/cache/*
!/system/storage/cache/index.html
/system/storage/logs/*
!/system/storage/logs/index.html
/system/storage/modification/*
!/system/storage/modification/index.html
/system/storage/session/*
!/system/storage/session/index.html
!/system/storage/session/.htaccess
/system/storage/upload/*
!/system/storage/upload/index.html
/image/cache/

# Kept under version control on purpose: PROJECT_MAP.md, .cursorrules
